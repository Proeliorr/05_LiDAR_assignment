# syntax=docker/dockerfile:1
#
# lidar-3dfin: the 3DFin v0.6.0 command line (`3DFin cli ...`) running headless.
#
#   docker build -f docker/3dfin/Dockerfile -t lidar-3dfin .          # context = project root
#   docker run --rm -v <host>/data:/data lidar-3dfin \
#       cli /data/in/x.laz /data/out/run/dfin /data/out/run/dfin/params.ini --normalize
#
# Why a two-stage build from the submodule instead of a plain `pip install ./third_party/3DFin`:
# the GUI modules (three_d_fin.gui.main_window / expert_dlg / gui_ressources_rc) are gitignored and
# are only generated by the hatch *sdist* build hook (scripts/qt_build_hook.py, pyside6-uic/rcc).
# A direct `pip install` of the source tree skips that hook, yet the CLI entry point imports the
# GUI package unconditionally, so the installed `3DFin` would die with ImportError. The builder
# stage therefore runs `python -m build --sdist` (hook fires), then builds the wheel *from that
# sdist*. The upstream submodule on the host is never touched: it is COPYed into the image and
# the generated files only exist inside the builder stage.

ARG PYTHON_IMAGE=python:3.12-slim
# 3DFin pins pyside6~=6.8.1 for its build hook; use the same series at runtime.
ARG PYSIDE6_SPEC="~=6.8.1"

# ---------------------------------------------------------------------------------------------
# Stage 0: shared base. Headless Qt needs its shared libraries to resolve (QApplication is
# imported even in CLI mode, and pyside6-uic/rcc in the build hook are Qt binaries too), but no
# display is ever needed.
# ---------------------------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS base

ENV QT_QPA_PLATFORM=offscreen \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Minimal set found with `ldd` over libQt6{Core,Gui,Widgets} + the offscreen platform plugin and
# the uic/rcc binaries (libx11-6, libfreetype6 and libglvnd come in as dependencies of these).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libgl1 libegl1 libxkbcommon0 libfontconfig1 libdbus-1-3 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------------------------
# Stage 1: generate the Qt files via the sdist hook and produce a complete wheel
# ---------------------------------------------------------------------------------------------
FROM base AS wheel-builder
ARG PYSIDE6_SPEC

# Build tooling first so this layer is cached. The hook needs pyside6-uic / pyside6-rcc on PATH
# and `import PySide6`; PySide6-Essentials ships all three. --no-isolation (below) makes the
# hook see this environment instead of a throw-away one, and -x skips build's metadata check
# that would insist on the `pyside6` meta-package (Essentials alone is enough for the hook).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install build "hatchling~=1.24" "pyside6-essentials${PYSIDE6_SPEC}"

COPY third_party/3DFin /src/3DFin
WORKDIR /src/3DFin

# The hook swallows pyside6-uic/rcc failures (it ignores their exit codes), so the build is
# made to fail if its outputs are missing from the sdist.
RUN python -m build --sdist --no-isolation -x --outdir /dist . \
 && tar -tzf /dist/*.tar.gz | tee /tmp/sdist.lst \
 && for f in gui/main_window.py gui/expert_dlg.py gui/gui_ressources_rc.py; do \
        grep -q "src/three_d_fin/$f\$" /tmp/sdist.lst || { echo "FATAL: $f missing from sdist (Qt hook did not run)"; exit 1; }; \
    done \
 && pip wheel --no-deps --no-build-isolation --wheel-dir /wheels /dist/*.tar.gz \
 && ls -l /dist /wheels

# ---------------------------------------------------------------------------------------------
# Stage 2: runtime image
# ---------------------------------------------------------------------------------------------
FROM base AS runtime
ARG PYSIDE6_SPEC

# Dependency layer, cached until 3DFin's pyproject.toml changes. The requirement list is read
# from the submodule's own pyproject.toml so it cannot drift from the pinned version. Only the
# Qt requirement is swapped: 3DFin needs QtCore/QtGui/QtWidgets, all in PySide6-Essentials,
# so the much larger PySide6-Addons from the `pyside6` meta-package is skipped
# (consequence: `pip check` reports the unmet `pyside6` requirement of 3DFin; harmless).
COPY third_party/3DFin/pyproject.toml /tmp/3dfin/pyproject.toml
RUN python - <<'PY'
import tomllib
with open("/tmp/3dfin/pyproject.toml", "rb") as f:
    deps = tomllib.load(f)["project"]["dependencies"]
keep = [d for d in deps if not d.lower().replace("_", "-").startswith("pyside6")]
with open("/tmp/3dfin/requirements.txt", "w") as f:
    f.write("\n".join(keep) + "\n")
print(open("/tmp/3dfin/requirements.txt").read())
PY
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/3dfin/requirements.txt "pyside6-essentials${PYSIDE6_SPEC}"

# The 3DFin wheel itself (changes whenever the submodule changes).
RUN --mount=type=bind,from=wheel-builder,source=/wheels,target=/wheels \
    pip install --no-deps /wheels/*.whl

# Fail the build if the headless CLI cannot even start.
RUN 3DFin --version && 3DFin cli --help >/dev/null

ENTRYPOINT ["3DFin"]
